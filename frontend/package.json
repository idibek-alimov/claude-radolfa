{
  "name": "radolfa-frontend",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:storefront": "npm run dev -w @radolfa/storefront",
    "build:storefront": "npm run build -w @radolfa/storefront",
    "start:storefront": "npm run start -w @radolfa/storefront",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
